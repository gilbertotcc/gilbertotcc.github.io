{
  "general": {
    "checkpointing": {
      "enabled": true
    }
  },
  "experimental": {
    "enableAgents": true
  },
  "security": {},
  "ui": {
    "theme": "Default"
  },
  "mcpServers": {
    "Astro docs": {
      "httpUrl": "https://mcp.docs.astro.build/mcp"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp", "--api-key", "${CONTEXT7_API_KEY}"]
    },
    "githubCopilot": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    }
  },
  "telemetry": {
    "enabled": true,
    "target": "gcp"
  }
}
