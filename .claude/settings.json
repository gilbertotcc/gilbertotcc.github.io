{
  "permissions": {
    "deny": [
      "Edit(terraform/**)",
      "Write(terraform/**)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(curriculum-vitae/**)",
      "Write(curriculum-vitae/**)",
      "Bash(tofu apply*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-tofu-apply.sh"
          }
        ]
      }
    ]
  }
}
