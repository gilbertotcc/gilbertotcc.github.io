{
  "general": {
    "checkpointing": {
      "enabled": false
    }
  },
  "experimental": {
    "enableAgents": false
  },
  "security": {},
  "ui": {
    "theme": "Default"
  },
  "mcpServers": {
    "Astro docs": {
      "httpUrl": "https://mcp.docs.astro.build/mcp"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp", "--api-key", "${CONTEXT7_API_KEY}"]
    }
  },
  "telemetry": {
    "enabled": true,
    "target": "gcp"
  }
}
