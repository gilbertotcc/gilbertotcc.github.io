---
import { SITE } from '../config';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  isProse?: boolean;
  frontmatter?: {
    title: string;
    description: string;
    canonicalUrl?: string;
  };
}

const { frontmatter, isProse: isProseProp } = Astro.props;

// Title and description can come from props or from Markdown frontmatter
const title = Astro.props.title || frontmatter?.title || SITE.title;
const description = Astro.props.description || frontmatter?.description || SITE.description;
const canonicalUrl = Astro.props.canonicalUrl || frontmatter?.canonicalUrl;

// If frontmatter exists, it's likely a Markdown page, so default isProse to true
const isProse = isProseProp !== undefined ? isProseProp : (!!frontmatter);

// Use Astro.url to build an absolute URL if one is not provided.
const canonicalURL = canonicalUrl || new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;

const isProd = import.meta.env.PROD;
const pathname = Astro.url.pathname;
---
<html lang={SITE.lang}>
  <head>
    {isProd && (
      <>
        <!-- Cookiebot -->
        <script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid={SITE.cookiebotId} data-blockingmode="auto" type="text/javascript" is:inline></script>
        <!-- Google Consent Mode (GCM) -->
        <script data-cookieconsent="ignore" is:inline>window.dataLayer = window.dataLayer || []; function gtag() { dataLayer.push(arguments); } gtag("consent", "default", { ad_personalization: "denied", ad_storage: "denied", ad_user_data: "denied", analytics_storage: "denied", functionality_storage: "denied", personalization_storage: "denied", security_storage: "granted", wait_for_update: 500, }); gtag("set", "ads_data_redaction", true); gtag("set", "url_passthrough", false);</script>
      </>
    )}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content="website" />

    <!-- Font Awesome -->
    <link id="fa-stylesheet" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.0.0/css/all.min.css" />

    {isProd && (
      <>
        <!-- Google Analytics 4 — Cookiebot-controlled -->
        <script
          type="text/plain"
          data-cookieconsent="statistics"
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${SITE.googleAnalyticsId}`}
          is:inline
        ></script>
        <script type="text/plain" data-cookieconsent="statistics" define:vars={{ gaId: SITE.googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId, {
            'anonymize_ip': true
          });
        </script>
      </>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="site-header">
      <nav class="nav-inner" aria-label="Main navigation">
        <a href="/" class="nav-brand">{SITE.author.name}</a>
        <ul class="nav-links">
          <li>
            <a href="/" aria-current={pathname === "/" ? "page" : undefined}>Home</a>
          </li>
          <li>
            <a href="/thought-leadership" aria-current={pathname === "/thought-leadership" ? "page" : undefined}>Thought Leadership</a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main-content" class={`main-content container ${isProse ? 'prose' : ''}`}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-meta">
          {SITE.author && <p><strong>{SITE.author.name}</strong></p>}
          <p>{SITE.description}</p>
          <p>
            <a href="/privacy">Privacy Policy</a>
            •
            <a href="javascript:Cookiebot.renew()">Cookie Settings</a>
          </p>
        </div>

        <div class="footer-social">
          <ul aria-label="Social media links">
            {SITE.social.linkedin && (
              <li>
                <a href={SITE.social.linkedin} rel="me nofollow noreferrer">
                  <i class="fab fa-linkedin" aria-hidden="true"></i> LinkedIn
                </a>
              </li>
            )}
            {SITE.social.github && (
              <li>
                <a href={SITE.social.github} rel="me nofollow noreferrer">
                  <i class="fab fa-github" aria-hidden="true"></i> GitHub
                </a>
              </li>
            )}
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
