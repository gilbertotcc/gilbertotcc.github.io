---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const speakingEntries = await getCollection('speaking');
const speaking = speakingEntries[0]?.data || [];

const reviewsEntries = await getCollection('reviews');
const reviews = reviewsEntries[0]?.data || [];

const publicationsEntries = await getCollection('publications');
const publications = publicationsEntries[0]?.data || [];

const title = "Thought Leadership — Gilberto Taccari, CTO & Fintech Engineering Leader";
const description = "Public speaking, technical manuscript reviews, and academic research by Gilberto Taccari: CTO in fintech Europe, Open Banking and PSD2 compliance architect, AI-native engineering practitioner.";
---

<BaseLayout title={title} description={description}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">Thought Leadership</h1>
    </header>

    <div class="post-content">
      <!--
        SEO note: the introductory section below was generated by Perplexity AI
        on 2026-05-16 to address a Google Search Console "Discovered, not indexed"
        signal caused by thin textual content. Review and update this prose whenever
        speaking appearances, reviews, or research focus change significantly.
      -->
      <p>
        Throughout my career as a CTO and engineering leader in European fintech, I have
        contributed to the broader technology community through public speaking, peer
        manuscript reviewing, and academic research. These activities reflect my commitment
        to Open Banking, PSD2 compliance architecture, AI-native engineering, and
        rigorous software craftsmanship in regulated, high-growth environments.
      </p>

      <p>
        On stage, I share hard-won lessons from building and scaling engineering teams
        inside fast-moving fintech startups and scaleups — covering topics from distributed
        systems resilience to the cultural challenges of technical leadership under
        regulatory pressure. As a technical reviewer for Manning Publications since 2019,
        I help ensure that practitioner-focused books on software architecture, cloud
        computing, and modern development practices reach developers with accuracy and depth.
        My earlier research, conducted during my academic training at the University of
        Florence, explored Internet of Things (IoT) protocols, cloud service models, and
        formal verification methods — work that continues to inform how I reason about
        system design and correctness today.
      </p>

      <section>
        <h2>Speaking Appearances</h2>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Role</th>
                <th>Topic</th>
              </tr>
            </thead>
            <tbody>
              {speaking.map((talk) => (
                <tr>
                  <td>{talk.date}</td>
                  <td>{talk.event}</td>
                  <td>{talk.role}</td>
                  <td>{talk.topic}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2>Manuscript Reviews</h2>
        <p>Technical reviews for <strong>Manning Publications</strong> since 2019.</p>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Year</th>
                <th>Title</th>
                <th>Author</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {reviews.map((review) => (
                <tr>
                  <td>{review.year}</td>
                  <td>
                    <a href={review.link}>{review.title}</a>
                  </td>
                  <td>{review.author}</td>
                  <td>Pub. {review.published}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2>Academic Publications</h2>
        <p>
          My research focuses on the Internet of Things (IoT), cloud computing, and formal
          verification.
        </p>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Year</th>
                <th>Title</th>
                <th>Authors</th>
                <th>Publication</th>
              </tr>
            </thead>
            <tbody>
              {publications.map((pub) => (
                <tr>
                  <td>{pub.year}</td>
                  <td>
                    <strong>{pub.title}</strong>
                  </td>
                  <td>{pub.author}</td>
                  <td>
                    <em>{pub.booktitle || pub.journal || pub.school || pub.organization || pub.publisher}</em>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
